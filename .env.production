# 배포(Vercel) 빌드에서만 쓰이는 값. `npm start` 개발 서버에는 적용되지 않는다.
#
# 리더기 서버(nfc_server.py)는 키오스크(라즈베리파이) 안에서 5000 포트로 돈다.
# 그런데 https 로 배포된 페이지가 로컬 주소를 부르는 것은 크롬 142 부터
# "로컬 네트워크 접근" 권한 없이는 차단된다.
#
# 지금은 키오스크 크로미움에서 그 권한을 한 번 허용해 주는 방식으로 쓴다.
#   사이트 정보(주소창 왼쪽 아이콘) -> 권한 -> 로컬 네트워크 액세스 -> 허용
# 권한은 기기+사이트별로 한 번만 주면 계속 유지된다.
#
# 키오스크를 여러 대로 늘리거나 권한 팝업을 띄울 수 없는 환경이 되면,
# 리더기를 zrok 터널로 내보내는 방식으로 바꾸면 된다. 그때는 아래 값을
# https 터널 주소로 바꾸고 라즈베리파이에서 deploy/install-zrok-tunnel.sh 를 돌린다.
#   예) REACT_APP_NFC_URL=https://<공유-이름>.shares.zrok.io

# 백엔드(Django). 별도 서버에 있고 배포된 페이지가 직접 부른다.
#
# 예전에 zrok 터널을 쓸 때는 이 값이 /api 였고, 같은 오리진 프록시(api/proxy.js)가
# 우회 헤더를 대신 붙여 줘야 했다. 백엔드를 옮기면서 그 프록시는 지웠다.
#
# 이 파일은 공개 저장소에 올라가므로 아래 백엔드 주소는 예시 값이다. 실제 주소는
# 커밋하지 말고 배포 환경 변수나 .env.production.local(.gitignore 대상)에 넣는다.
# 끝에 슬래시를 붙이지 말 것. 코드가 `${BASE_URL}/dasibom/...` 로 이어 붙인다.
REACT_APP_API_BASE=https://dasibom-backend.example.com
REACT_APP_NFC_URL=http://127.0.0.1:5000

# 이 키오스크의 고유 ID. 기기마다 다르게 넣는다.
# 긴급 신고와 위치 공유를 어느 키오스크에서 보냈는지 백엔드에 알리는 값이다.
# 키링 좌표는 태그한 UID 로 백엔드에서 찾으므로 키링 쪽 ID 와 맞출 필요가 없다.
REACT_APP_DEVICE_ID=KIOSK_001

# 스티커 UID -> 키링 매핑은 백엔드가 들고 있다. (Device.badge_uid)
# 키링을 늘릴 때는 백엔드에 등록만 하면 되고 이 파일은 건드리지 않아도 된다.
#   UID 확인: 라즈베리파이에서 journalctl -u nfc-server -f 실행 후 스티커 태그
